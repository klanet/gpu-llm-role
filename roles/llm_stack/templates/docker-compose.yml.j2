# Managed by Ansible - не редактируйте вручную
name: llm
services:
  llm:
    container_name: llm
{% if llm_engine == 'vllm' %}
    image: {{ vllm_image }}
    command:
      - "--model"
      - "{{ llm_model }}"
      - "--host"
      - "0.0.0.0"
      - "--port"
      - "{{ llm_internal_port }}"
{% for a in vllm_extra_args %}
      - "{{ a }}"
{% endfor %}
    ipc: host
    environment:
      HUGGING_FACE_HUB_TOKEN: "${HF_TOKEN:-}"
{% for k, v in vllm_env.items() %}
      {{ k }}: "{{ v }}"
{% endfor %}
    volumes:
      - {{ llm_dir }}/hf-cache:/root/.cache/huggingface
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request as u; u.urlopen('http://localhost:{{ llm_internal_port }}/health', timeout=5)"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 600s
{% else %}
    image: {{ ollama_image }}
    environment:
      OLLAMA_KEEP_ALIVE: "-1"
    volumes:
      - {{ llm_dir }}/ollama:/root/.ollama
    healthcheck:
      test: ["CMD", "ollama", "list"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
{% endif %}
    restart: unless-stopped
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    logging:
      driver: json-file
      options: { max-size: "50m", max-file: "5" }

  gateway:
    container_name: llm-gateway
    image: ghcr.io/berriai/litellm:main-stable
    command:
      - "--config"
      - "/app/config.yaml"
      - "--host"
      - "0.0.0.0"
      - "--port"
      - "4000"
    depends_on:
      llm:
        condition: service_healthy
    ports:
      - "{{ api_bind }}:{{ api_port }}:4000"
    volumes:
      - {{ llm_dir }}/litellm-config.yaml:/app/config.yaml:ro
{% if api_tls_enabled %}
      - {{ llm_dir }}/certs:/app/certs:ro
    environment:
      LITELLM_SSL_CERTFILE: "/app/certs/tls.crt"
      LITELLM_SSL_KEYFILE: "/app/certs/tls.key"
{% endif %}
    restart: unless-stopped
    logging:
      driver: json-file
      options: { max-size: "50m", max-file: "5" }

{% if dcgm_enabled %}
  dcgm-exporter:
    container_name: dcgm-exporter
    image: {{ dcgm_image }}
    cap_add: [SYS_ADMIN]
    ports:
      - "{{ dcgm_bind_address }}:{{ dcgm_port }}:9400"
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    restart: unless-stopped
{% endif %}
